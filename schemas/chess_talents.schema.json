{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "棋手天賦": {
      "type": "object",
      "properties": {
        "神兵": {
          "type": "object",
          "properties": {
            "說明": {
              "type": "string",
              "minLength": 1
            },
            "可使用神兵商店": {
              "type": "boolean"
            }
          },
          "required": [
            "說明",
            "可使用神兵商店"
          ],
          "additionalProperties": false
        },
        "晚成": {
          "type": "object",
          "properties": {
            "說明": {
              "type": "string",
              "minLength": 1
            },
            "勝場成長受加成比例": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "說明",
            "勝場成長受加成比例"
          ],
          "additionalProperties": false
        },
        "賭徒": {
          "type": "object",
          "properties": {
            "說明": {
              "type": "string",
              "minLength": 1
            },
            "開局額外禁棋": {
              "type": "object",
              "properties": {
                "次數": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "最低費用": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "最高費用": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "次數",
                "最低費用",
                "最高費用"
              ],
              "additionalProperties": false
            },
            "賭運": {
              "type": "object",
              "properties": {
                "累積截止關卡": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "目標最低費用": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "目標最高費用": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "每次增加層數": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "每層觸發機率百分點": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "觸發機率上限": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "觸發後生命": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "無敵幀數": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              },
              "required": [
                "累積截止關卡",
                "目標最低費用",
                "目標最高費用",
                "每次增加層數",
                "每層觸發機率百分點",
                "觸發機率上限",
                "觸發後生命",
                "無敵幀數"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "說明",
            "開局額外禁棋",
            "賭運"
          ],
          "additionalProperties": false
        },
        "中堅": {
          "type": "object",
          "properties": {
            "說明": {
              "type": "string",
              "minLength": 1
            },
            "目標費用": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "額外星級加成": {
              "type": "object",
              "properties": {
                "每顆開場內力": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "計算上限": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "每顆開場內力",
                "計算上限"
              ],
              "additionalProperties": false
            },
            "刷新保證": {
              "type": "object",
              "properties": {
                "觸發星級": {
                  "const": 2
                },
                "每次數量": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "觸發星級",
                "每次數量"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "說明",
            "目標費用",
            "額外星級加成",
            "刷新保證"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "神兵",
        "晚成",
        "賭徒",
        "中堅"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "棋手天賦"
  ],
  "additionalProperties": false
}
